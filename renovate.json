{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["custom.regex"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container image tags pinned in group_vars with a '# renovate:' comment",
      "managerFilePatterns": ["/^group_vars/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n[^:\\n]+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}
