services:
  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:{{ ha_image_tag }}
    container_name: homeassistant
    network_mode: host
    volumes:
      - /home/{{ admin_user }}/services/homeassistant/config:/config
      - /etc/localtime:/etc/localtime:ro
      - /etc/letsencrypt/live:/etc/letsencrypt/live:ro
      - /etc/letsencrypt/archive:/etc/letsencrypt/archive:ro
{% if bluetooth_enabled | bool %}
      # Host system bus for BlueZ. Root in the container is root on this bus,
      # so only mount it when Bluetooth is actually wanted.
      - /run/dbus:/run/dbus:ro
{% endif %}

    deploy:
      resources:
        limits:
          memory: {{ ha_memory_limit | default('2g') }}
    restart: unless-stopped
